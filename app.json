{
  "expo": {
    "name": "testEXPO",
    "slug": "testEXPO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFA825"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFA825"
      },
      "permissions": [
        "CAMERA_ROLL"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
